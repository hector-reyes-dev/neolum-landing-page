---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="border-y border-[var(--color-primary)]/30 bg-[var(--color-bg)]">
  <div class="container-shell flex items-center justify-between py-4 sm:py-5">
    <h2 class="text-balance text-2xl font-bold text-[var(--color-primary)] sm:text-3xl lg:text-4xl">
      {title}
    </h2>
    <img
      src="/assets/NEOLUM_ICONO.svg"
      alt=""
      class="h-10 w-auto sm:h-12 lg:h-14"
      loading="lazy"
      aria-hidden="true"
    />
  </div>
</div>
