---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="border-t border-[var(--color-primary)] bg-[var(--color-bg)]">
  <div
    class="container-shell flex items-center justify-between py-3 pl-4 sm:py-4"
  >
    <h2
      class="text-balance text-[clamp(2.7rem,4vw,4rem)] font-bold leading-[0.92] text-[var(--color-primary)]"
    >
      {title}
    </h2>
    <img
      src="/assets/NEOLUM_ICONO.svg"
      alt=""
      class="h-12 w-auto sm:h-16 lg:h-20"
      loading="lazy"
      aria-hidden="true"
    />
  </div>
</div>
