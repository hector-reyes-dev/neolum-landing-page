---
import { contactDetails } from "../../constants/site";
---

<footer class="bg-[var(--color-primary)] text-white">
  <div
    class="container-shell grid gap-10 px-3 py-10 sm:px-8 sm:py-16 lg:grid-cols-[40%_60%] lg:justify-between lg:gap-0"
  >
    <div class="flex h-full flex-col justify-between gap-10 lg:gap-0 lg:pr-8">
      <div class="flex gap-16 text-[clamp(1.5rem,2vw,1.8rem)] font-bold">
        <ul class="space-y-4 border-r-2 border-white pr-18">
          <li>
            <a href="#nosotros" class="transition-opacity hover:opacity-80"
              >Nosotros</a
            >
          </li>
          <li>
            <a href="#servicios" class="transition-opacity hover:opacity-80"
              >Servicios</a
            >
          </li>
        </ul>
        <ul class="space-y-4">
          <li>
            <a href="#proyectos" class="transition-opacity hover:opacity-80"
              >Proyectos</a
            >
          </li>
          <li>
            <a href="#contacto" class="transition-opacity hover:opacity-80"
              >Contacto</a
            >
          </li>
        </ul>
      </div>

      <div class="space-y-1 text-[1.2rem] text-white/90 font-bold">
        <p>Términos y condiciones</p>
        <p>Aviso de privacidad</p>
      </div>

      <div class="space-y-1 text-[1.1rem] font-bold text-white">
        <a
          href={contactDetails.instagramUrl}
          target="_blank"
          rel="noreferrer"
          class="flex cursor-pointer items-center gap-2 transition-opacity hover:opacity-80 focus-visible:opacity-80"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="size-6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
            <circle cx="12" cy="12" r="4.2"></circle>
            <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"
            ></circle>
          </svg>
          <p>{contactDetails.handle}</p>
        </a>
        <p>
          <a
            href={`mailto:${contactDetails.email}`}
            class="cursor-pointer transition-opacity hover:opacity-80 focus-visible:opacity-80"
          >
            {contactDetails.email}
          </a>
        </p>
        <p>{contactDetails.web}</p>
      </div>
    </div>

    <a
      href="#top"
      aria-label="Volver arriba"
      class="flex w-full items-center justify-center overflow-hidden lg:items-end lg:justify-end"
    >
      <img
        src="/assets/LOGO_NEOLUM_PRINCIPAL.svg"
        alt="Logo NEO LUM"
        class="mx-auto h-full lg:mx-0 lg:max-w-none"
        loading="lazy"
      />
    </a>
  </div>
</footer>

<div class="bg-white py-2">
  <div class="container-shell text-center">
    <p class="text-[1.2rem] font-medium text-[var(--color-text)]">
      © 2026 All rights reserved to NEO LUM.
    </p>
  </div>
</div>
