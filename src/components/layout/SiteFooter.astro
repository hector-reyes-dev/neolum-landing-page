---
import { contactDetails } from "../../constants/site";
---

<footer class="bg-[var(--color-primary)] text-white">
  <div
    class="container-shell grid gap-10 py-10 px-8 sm:py-16 lg:grid-cols-[40%_60%] lg:justify-between lg:gap-0"
  >
    <div class="space-y-10 lg:pr-8">
      <div class="flex gap-16 text-[clamp(1.5rem,2vw,1.8rem)] font-bold">
        <ul class="space-y-4 border-r border-white/50 pr-8">
          <li>
            <a href="#nosotros" class="transition-opacity hover:opacity-80"
              >Nosotros</a
            >
          </li>
          <li>
            <a href="#servicios" class="transition-opacity hover:opacity-80"
              >Servicios</a
            >
          </li>
        </ul>
        <ul class="space-y-4">
          <li>
            <a href="#proyectos" class="transition-opacity hover:opacity-80"
              >Proyectos</a
            >
          </li>
          <li>
            <a href="#contacto" class="transition-opacity hover:opacity-80"
              >Contacto</a
            >
          </li>
        </ul>
      </div>

      <div class="space-y-1 text-[1.2rem] text-white/90 font-bold">
        <p>Términos y condiciones</p>
        <p>Aviso de privacidad</p>
      </div>

      <div class="space-y-1 text-[1.1rem] font-bold text-white/90">
        <p>{contactDetails.handle}</p>
        <p>{contactDetails.email}</p>
        {contactDetails.phones.map((phone: string) => <p>{phone}</p>)}
        <a
          href="https://instagram.com/placeholder"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de NEO LUM"
          class="inline-flex items-center gap-2 pt-2 text-white transition-opacity hover:opacity-80"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="size-6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
            <circle cx="12" cy="12" r="4.2"></circle>
            <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"
            ></circle>
          </svg>
          <span class="text-[1.5rem] font-bold">Instagram</span>
        </a>
      </div>
    </div>

    <a
      href="#top"
      aria-label="Volver arriba"
      class="flex items-end justify-end w-full overflow-hidden"
    >
      <img
        src="/assets/LOGO_NEOLUM_PRINCIPAL.svg"
        alt="Logo NEO LUM"
        class="h-full"
        loading="lazy"
      />
    </a>
  </div>
</footer>

<div class="bg-white py-2">
  <div class="container-shell text-center">
    <p class="text-[1.4rem] font-bold text-[var(--color-text)]">
      © 2026 All rights reserved to NEO LUM.
    </p>
  </div>
</div>
