---
interface Props {
  id?: string;
  class?: string;
  ariaLabel?: string;
  isContent?: boolean;
  flushMobile?: boolean;
}

const { id, class: className = "", ariaLabel, isContent = false, flushMobile = false } = Astro.props;
---

<section 
  id={id} 
  aria-label={ariaLabel} 
  class:list={[
    isContent ? "border-y border-[var(--color-primary)]" : "", 
    className
  ]}
>
  <div class:list={["container-shell", flushMobile ? "px-0 sm:px-0" : ""]}>
    <slot />
  </div>
</section>
