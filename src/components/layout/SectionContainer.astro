---
interface Props {
  id?: string;
  class?: string;
  ariaLabel?: string;
  isContent?: boolean;
  flushMobile?: boolean;
}

const {
  id,
  class: className = "",
  ariaLabel,
  isContent = false,
  flushMobile = false,
} = Astro.props;
---

<section id={id} aria-label={ariaLabel} class={className}>
  <div class="mx-auto w-full max-w-[var(--container-max)]">
    <slot />
  </div>
</section>
