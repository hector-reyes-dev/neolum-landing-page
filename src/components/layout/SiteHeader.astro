---
import { navLinks } from "../../constants/site";
---

<header class="py-6">
  <div class="container-shell">
    <div
      class="flex items-stretch overflow-hidden rounded-full border border-[var(--color-primary)] bg-white"
    >
      {/* Left: Logo section */}
      <a
        href="#top"
        aria-label="Ir al inicio"
        class="flex shrink-0 items-center border-r border-[var(--color-primary)] bg-white px-4 py-3 sm:px-6 sm:py-4"
      >
        <img
          src="/assets/LOGO_NEOLUM_SECUNDARIO.svg"
          alt="Logo NEO LUM"
          class="h-5 w-auto sm:h-7 animate-fade-up"
          loading="eager"
        />
      </a>

      {/* Center: Navigation - Hidden on mobile */}
      <nav aria-label="Navegacion principal" class="hidden flex-1 md:block">
        <ul
          class="flex h-full items-center justify-end gap-6 px-6 text-sm font-semibold"
        >
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[var(--color-text)] transition-colors hover:text-[var(--color-primary)]"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Spacer for mobile to push IG to right */}
      <div class="flex-1 md:hidden"></div>

      {/* Right: IG icon */}
      <a
        href="https://instagram.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="flex shrink-0 items-center justify-center self-stretch rounded-r-full bg-[var(--color-primary)] px-12 text-white transition-opacity hover:opacity-90 sm:px-8"
      >
        <span class="text-sm font-bold">IG</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.querySelector('header')?.classList.add('animate-slide-down');
</script>
