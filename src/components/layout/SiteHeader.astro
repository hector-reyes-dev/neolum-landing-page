---
import { navLinks } from "../../constants/site";
---

<header class="py-6">
  <div class="container-shell">
    <div class="flex items-center overflow-hidden rounded-full border border-[var(--color-primary)] bg-white">
      {/* Left: Logo section with divider */}
      <a href="#top" aria-label="Ir al inicio" class="flex shrink-0 items-center border-r border-[var(--color-primary)] bg-white px-5 py-3 sm:px-8 sm:py-4">
        <img
          src="/assets/LOGO_NEOLUM_SECUNDARIO.svg"
          alt="Logo NEO LUM"
          class="h-6 w-auto sm:h-8"
          loading="eager"
        />
      </a>

      {/* Center: Navigation */}
      <nav aria-label="Navegacion principal" class="flex-1">
        <ul class="flex items-center justify-center gap-4 px-4 text-sm font-semibold sm:gap-8 sm:text-base">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[var(--color-text)] transition-colors hover:text-[var(--color-primary)]"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Right: IG icon */}
      <a
        href="https://instagram.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="flex shrink-0 items-center justify-center bg-[var(--color-primary)] px-5 py-3 text-white transition-opacity hover:opacity-90 sm:px-8 sm:py-4"
      >
        <span class="text-sm font-bold sm:text-base">IG</span>
      </a>
    </div>
  </div>
</header>
