---
import { navLinks } from "../../constants/site";
---

<header class="border-y border-[var(--color-primary)] bg-white">
  <div class="container-shell">
    <div class="flex min-h-[6rem] items-stretch">
      <a
        href="#top"
        aria-label="Ir al inicio"
        class="flex shrink-0 items-center border-r border-[var(--color-primary)] px-4 sm:px-6"
      >
        <img
          src="/assets/LOGO_NEOLUM_SECUNDARIO.svg"
          alt="Logo NEO LUM"
          class="h-8 w-auto sm:h-16"
          loading="eager"
        />
      </a>

      <nav
        aria-label="Navegacion principal"
        class="flex min-w-0 flex-1 items-center justify-end"
      >
        <ul
          class="flex items-center gap-4 overflow-x-auto px-4 py-3 font-normal whitespace-nowrap sm:gap-12 sm:px-6 sm:text-[0.84rem]"
        >
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[var(--color-text)] text-[1.2rem] transition-colors hover:text-[var(--color-primary)]"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex w-14 shrink-0 items-center justify-center sm:w-16">
        <img
          src="/assets/NEOLUM_ICONO.svg"
          alt=""
          class="h-8 w-auto sm:h-16"
          aria-hidden="true"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</header>
