---
import SectionContainer from "../layout/SectionContainer.astro";

const slides = [
  "/assets/images/carousel11x.webp",
  "/assets/images/carousel21x.webp",
  "/assets/images/carousel31x.webp",
  "/assets/images/carousel41x.webp",
];
---

<SectionContainer
  id="nosotros"
  ariaLabel="Seccion principal"
  isContent={true}
  flushMobile={true}
>
  <div class="relative grid overflow-hidden bg-white lg:grid-cols-[58%_42%]">
    <div class="flex items-center bg-white px-4 py-4 sm:px-8 sm:py-5">
      <div>
        <h1
          class="text-balance text-[clamp(3.6rem,10vw,10rem)] font-bold leading-[0.88] text-[var(--color-primary)]"
        >
          Estrategia, identidad y crecimiento.
        </h1>
        <div class="space-y-2 text-[1.6rem] leading-[1.28] text-black">
          <p>
            En <span class="font-bold text-[var(--color-primary)]">NEO LUM</span
            >, ayudamos a empresas a destacar en un mercado saturado.
          </p>
          <p>
            Creamos identidades visuales autenticas y estrategias de marketing
            que no solo se ven bien, sino que conectan con tu cliente ideal y
            generan resultados reales.
          </p>
        </div>
        <a
          href="#contacto"
          class="mt-4 inline-flex items-center justify-center rounded-full bg-[var(--color-primary)] px-12 py-4 text-2xl font-semibold text-white transition-opacity hover:opacity-90"
        >
          Contáctanos
        </a>
      </div>
    </div>

    <div class="slider-wrapper min-h-[55vw] overflow-hidden lg:min-h-0">
      <div class="slider relative h-full overflow-hidden bg-white" data-hero-slider>
        <div
          class="slider-track flex h-full transition-transform duration-500 ease-out"
          data-hero-track
        >
          {
            slides.map((slide, index) => (
              <figure class="w-full shrink-0">
                <img
                  src={slide}
                  alt={`Imagen ${index + 1} del slider principal`}
                  class="h-full min-h-[10rem] w-full object-cover"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </figure>
            ))
          }
        </div>

        <div
          class="absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 gap-2"
        >
          {
            slides.map((_, index) => (
              <button
                type="button"
                class="slide-dot size-2.5 cursor-pointer rounded-full border transition-colors"
                aria-label={`Ir al slide ${index + 1}`}
                aria-pressed={index === 0 ? "true" : "false"}
                data-hero-dot
                data-slide-index={index}
              />
            ))
          }
        </div>
      </div>
    </div>

    <img
      src="/assets/NEOLUM_ICONO.svg"
      alt=""
      class="hero-diamond pointer-events-none absolute bottom-40 left-[58%] h-32 w-auto -translate-x-1/2"
      aria-hidden="true"
      loading="lazy"
    />
  </div>
</SectionContainer>

<script is:inline>
  const slider = document.querySelector("[data-hero-slider]");

  if (slider instanceof HTMLElement) {
    const track = slider.querySelector("[data-hero-track]");
    const dots = Array.from(slider.querySelectorAll("[data-hero-dot]"));

    const setActiveSlide = (index) => {
      if (!(track instanceof HTMLElement)) {
        return;
      }

      track.style.transform = `translateX(-${index * 100}%)`;

      dots.forEach((dot, dotIndex) => {
        if (dot instanceof HTMLButtonElement) {
          dot.setAttribute("aria-pressed", dotIndex === index ? "true" : "false");
        }
      });
    };

    dots.forEach((dot) => {
      if (dot instanceof HTMLButtonElement) {
        dot.addEventListener("click", () => {
          const index = Number(dot.dataset.slideIndex ?? 0);
          setActiveSlide(index);
        });
      }
    });

    setActiveSlide(0);
  }
</script>

<style>
  .slider-track {
    will-change: transform;
  }

  .slide-dot {
    border-color: color-mix(in srgb, var(--color-white) 55%, transparent);
    background-color: transparent;
  }

  .hero-diamond {
    display: none;
  }

  @media (min-width: 64rem) {
    .hero-diamond {
      display: block;
    }
  }

  .slide-dot[aria-pressed="true"] {
    background-color: var(--color-white);
    border-color: var(--color-white);
  }
</style>
