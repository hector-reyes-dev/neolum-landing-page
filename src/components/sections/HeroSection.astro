---
import SectionContainer from "../layout/SectionContainer.astro";

const slides = [
  "/assets/images/carousel11x.webp",
  "/assets/images/carousel21x.webp",
  "/assets/images/carousel31x.webp",
];
---

<SectionContainer
  id="nosotros"
  ariaLabel="Seccion principal"
  isContent={true}
  flushMobile={true}
>
  <div class="relative grid overflow-hidden bg-white lg:grid-cols-[58%_42%]">
    <div class="flex items-center bg-white px-4 py-8 sm:px-8 sm:py-10">
      <div>
        <h1
          class="text-balance text-[clamp(3.6rem,10vw,10rem)] font-bold leading-[0.88] text-[var(--color-primary)]"
        >
          Estrategia, identidad y crecimiento.
        </h1>
        <div class="space-y-4 text-[1.6rem] leading-[1.28] text-black">
          <p>
            En <span class="font-bold text-[var(--color-primary)]">NEO LUM</span
            >, ayudamos a empresas a destacar en un mercado saturado.
          </p>
          <p>
            Creamos identidades visuales autenticas y estrategias de marketing
            que no solo se ven bien, sino que conectan con tu cliente ideal y
            generan resultados reales.
          </p>
        </div>
        <a
          href="#contacto"
          class="inline-flex items-center justify-center mt-8 rounded-full bg-[var(--color-primary)] px-12 py-6 text-2xl font-semibold text-white transition-opacity hover:opacity-90"
        >
          Contáctanos
        </a>
      </div>
    </div>

    <div class="slider-wrapper min-h-[55vw] overflow-hidden lg:min-h-0">
      <div class="slider relative h-full overflow-hidden bg-white">
        {
          slides.map((_, index) => (
            <input
              type="radio"
              name="hero-slider"
              id={`slide-${index}`}
              class="slide-input sr-only"
              checked={index === 0}
            />
          ))
        }

        <div
          class="slider-track flex h-full transition-transform duration-500 ease-out"
        >
          {
            slides.map((slide, index) => (
              <figure class="w-full shrink-0">
                <img
                  src={slide}
                  alt={`Imagen ${index + 1} del slider principal`}
                  class="h-full min-h-[10rem] w-full object-cover"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </figure>
            ))
          }
        </div>

        <div
          class="absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 gap-2"
        >
          {
            slides.map((_, index) => (
              <label
                for={`slide-${index}`}
                class="slide-dot size-2.5 cursor-pointer rounded-full border transition-colors"
                aria-label={`Ir al slide ${index + 1}`}
              />
            ))
          }
        </div>
      </div>
    </div>

    <img
      src="/assets/NEOLUM_ICONO.svg"
      alt=""
      class="pointer-events-none absolute bottom-40 left-[58%] hidden h-32 w-auto -translate-x-1/2 lg:block"
      aria-hidden="true"
      loading="lazy"
    />
  </div>
</SectionContainer>

<style>
  .slider-wrapper:has(#slide-0:checked) .slider-track {
    transform: translateX(0%);
  }
  .slider-wrapper:has(#slide-1:checked) .slider-track {
    transform: translateX(-100%);
  }
  .slider-wrapper:has(#slide-2:checked) .slider-track {
    transform: translateX(-200%);
  }
  .slider-wrapper:has(#slide-3:checked) .slider-track {
    transform: translateX(-300%);
  }

  .slide-dot {
    border-color: color-mix(in srgb, var(--color-white) 55%, transparent);
    background-color: transparent;
  }

  .slider-wrapper:has(#slide-0:checked) label[for="slide-0"],
  .slider-wrapper:has(#slide-1:checked) label[for="slide-1"],
  .slider-wrapper:has(#slide-2:checked) label[for="slide-2"],
  .slider-wrapper:has(#slide-3:checked) label[for="slide-3"] {
    background-color: var(--color-white);
    border-color: var(--color-white);
  }
</style>
