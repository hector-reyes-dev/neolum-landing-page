---
import SectionContainer from "../layout/SectionContainer.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import {
  brandServices,
  marketingServices,
  webServices,
  strategyServices,
} from "../../constants/site";
---

<SectionTitle title="Servicios" />

<SectionContainer
  id="servicios"
  ariaLabel="Seccion de servicios"
  isContent={true}
  flushMobile={true}
>
  <div class="grid">
    <!-- Row 1: Brand (Left) | Marketing (Right) -->
    <!-- Image starts on the LEFT, slides RIGHT only when hovering that left quadrant -->
    <div class="relative grid overflow-hidden md:grid-cols-2">
      <!-- T1: Construcción y Evolución de Marca (under image, revealed on hover) -->
      <div
        class="flex flex-col justify-center bg-[var(--color-bg)] px-6 py-10 sm:px-8 md:aspect-square md:px-12"
      >
        <h3
          class="text-center text-[clamp(2rem,3.8vw,3.4rem)] font-bold leading-[0.92] text-[var(--color-primary)]"
        >
          Construcción y<br />Evolución de Marca
        </h3>
        <ul
          class="mx-auto mt-8 max-w-[36rem] space-y-5 text-[clamp(1.45rem,2.25vw,2.15rem)] leading-[1.05] text-black"
        >
          {
            brandServices.map((service) => (
              <li class="text-balance">• {service}</li>
            ))
          }
        </ul>
      </div>

      <!-- T2: Marketing Digital y Contenidos (always visible) -->
      <div
        class="flex flex-col justify-center bg-[var(--color-bg)] px-6 py-10 sm:px-8 md:aspect-square md:px-12"
      >
        <h3
          class="text-center text-[clamp(2rem,3.8vw,3.4rem)] font-bold leading-[0.92] text-[var(--color-primary)]"
        >
          Marketing Digital<br />y Contenidos
        </h3>
        <ul
          class="mx-auto mt-8 max-w-[36rem] space-y-5 text-[clamp(1.45rem,2.25vw,2.15rem)] leading-[1.05] text-black"
        >
          {
            marketingServices.map((service) => (
              <li class="text-balance">• {service}</li>
            ))
          }
        </ul>
      </div>

      <!-- IMG 1: positioned on the LEFT, only triggers on hovering itself -->
      <figure
        data-service-img="row1"
        class="absolute inset-y-0 left-0 hidden w-1/2 translate-x-0 cursor-default transition-transform duration-700 ease-in-out md:block"
      >
        <img
          src="/assets/images/servicios-11x.webp"
          alt="Construcción y Evolución de Marca"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </figure>

      <!-- Mobile Image 1 -->
      <figure class="relative h-[40vh] overflow-hidden md:hidden">
        <img
          src="/assets/images/servicios-11x.webp"
          alt="Servicios de Marca"
          class="h-full w-full object-cover"
        />
      </figure>
    </div>

    <!-- Row 2: Web (Left) | Strategy (Right) -->
    <!-- Image starts on the RIGHT, slides LEFT only when hovering that right quadrant -->
    <div
      class="relative grid overflow-hidden md:grid-cols-2 border-t border-[var(--color-primary)]/10"
    >
      <!-- T3: Presencia Web y Digital (always visible) -->
      <div
        class="flex flex-col justify-center bg-[var(--color-bg)] px-6 py-10 sm:px-8 md:aspect-square md:px-12"
      >
        <h3
          class="text-center text-[clamp(2rem,3.8vw,3.4rem)] font-bold leading-[0.92] text-[var(--color-primary)]"
        >
          Presencia Web<br />y Digital
        </h3>
        <ul
          class="mx-auto mt-8 max-w-[36rem] space-y-5 text-[clamp(1.45rem,2.25vw,2.15rem)] leading-[1.05] text-black"
        >
          {
            webServices.map((service) => (
              <li class="text-balance">• {service}</li>
            ))
          }
        </ul>
      </div>

      <!-- T4: Estrategia y Consultoría (under image, revealed on hover) -->
      <div
        class="flex flex-col justify-center bg-[var(--color-bg)] px-6 py-10 sm:px-8 md:aspect-square md:px-12"
      >
        <h3
          class="text-center text-[clamp(2rem,3.8vw,3.4rem)] font-bold leading-[0.92] text-[var(--color-primary)]"
        >
          Estrategia y<br />Consultoría
        </h3>
        <ul
          class="mx-auto mt-8 max-w-[36rem] space-y-5 text-[clamp(1.45rem,2.25vw,2.15rem)] leading-[1.05] text-black"
        >
          {
            strategyServices.map((service) => (
              <li class="text-balance">• {service}</li>
            ))
          }
        </ul>
      </div>

      <!-- IMG 2: positioned on the RIGHT, only triggers on hovering itself -->
      <figure
        data-service-img="row2"
        class="absolute inset-y-0 right-0 hidden w-1/2 translate-x-0 cursor-default transition-transform duration-700 ease-in-out md:block"
      >
        <img
          src="/assets/images/servicios-21x.webp"
          alt="Estrategia y Consultoría"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </figure>

      <!-- Mobile Image 2 -->
      <figure class="relative h-[40vh] overflow-hidden md:hidden">
        <img
          src="/assets/images/servicios-21x.webp"
          alt="Servicios de Estrategia"
          class="h-full w-full object-cover"
        />
      </figure>
    </div>
  </div>
</SectionContainer>

<script is:inline>
  // Hover only fires when cursor is over the figure (the image quadrant)
  const img1 = document.querySelector('[data-service-img="row1"]');
  const img2 = document.querySelector('[data-service-img="row2"]');

  if (img1) {
    img1.addEventListener("mouseenter", () => {
      img1.style.transform = "translateX(100%)";
    });
    img1.addEventListener("mouseleave", () => {
      img1.style.transform = "translateX(0%)";
    });
  }

  if (img2) {
    img2.addEventListener("mouseenter", () => {
      img2.style.transform = "translateX(-100%)";
    });
    img2.addEventListener("mouseleave", () => {
      img2.style.transform = "translateX(0%)";
    });
  }
</script>
