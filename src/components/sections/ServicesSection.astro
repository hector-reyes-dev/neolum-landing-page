---
import SectionContainer from "../layout/SectionContainer.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { marketingServices, webServices } from "../../constants/site";
---

<SectionTitle title="Servicios" />

<SectionContainer
  id="servicios"
  ariaLabel="Seccion de servicios"
  isContent={true}
  flushMobile={true}
>
  <div class="grid md:grid-cols-2">
    <figure class="overflow-hidden">
      <img
        src="/assets/placeholders/PLACEHOLDER_01.webp"
        alt="Imagen de apoyo para seccion de servicios"
        class="aspect-square w-full object-cover md:aspect-[4/3]"
        loading="lazy"
      />
    </figure>

    <div
      class="flex flex-col justify-center bg-[var(--color-bg)] px-6 py-10 sm:px-8 md:px-12"
    >
      <h3
        class="text-center text-[clamp(2rem,3.8vw,3.4rem)] font-bold leading-[0.92] text-[var(--color-primary)]"
      >
        Marketing Digital<br />y Contenidos
      </h3>
      <ul
        class="mx-auto mt-8 max-w-[36rem] space-y-5 text-[clamp(1.45rem,2.25vw,2.15rem)] leading-[1.05] text-black"
      >
        {
          marketingServices.map((service) => (
            <li class="text-balance">• {service}</li>
          ))
        }
      </ul>
    </div>

    <div
      class="flex flex-col justify-center bg-[var(--color-bg)] px-6 py-10 sm:px-8 md:px-12"
    >
      <h3
        class="text-center text-[clamp(2rem,3.8vw,3.4rem)] font-bold leading-[0.92] text-[var(--color-primary)]"
      >
        Presencia Web<br />y Digital
      </h3>
      <ul
        class="mx-auto mt-8 max-w-[36rem] space-y-5 text-[clamp(1.45rem,2.25vw,2.15rem)] leading-[1.05] text-black"
      >
        {
          webServices.map((service) => (
            <li class="text-balance">• {service}</li>
          ))
        }
      </ul>
    </div>

    <figure class="overflow-hidden">
      <img
        src="/assets/placeholders/PLACEHOLDER_04.webp"
        alt="Imagen de apoyo para seccion de diseno"
        class="aspect-square w-full object-cover md:aspect-[4/3]"
        loading="lazy"
      />
    </figure>
  </div>
</SectionContainer>
