---
import SectionContainer from "../layout/SectionContainer.astro";
---

<section
  id="proceso"
  aria-label="Seccion de proceso"
  class="bg-[var(--color-bg)]"
>
  <SectionContainer isContent={true} flushMobile={true}>
    <div class="group/process relative overflow-hidden" data-process-container>
      <!-- Block 1: Fundación, Desarrollo, Gestión -->
      <div
        data-hover-zone="1"
        class="relative z-0 w-full overflow-hidden bg-[var(--color-soft)] py-12 sm:py-20 lg:py-24"
      >
        <!-- Background logo watermark -->
        <img
          src="/assets/LOGO_NEOLUM_SECUNDARIO_WHITE.svg"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 inset-y-0 m-auto w-[85%] max-w-none opacity-20 select-none"
        />
        <div class="relative mx-auto grid max-w-3xl gap-10 text-center">
          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Fundación
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              Escuchamos, investigamos y definimos la estrategia y el rumbo de
              tu marca.
            </p>
          </article>
          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Desarrollo
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              Creamos tu identidad visual, diseñamos tu web y planificamos tu
              contenido.
            </p>
          </article>
          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Gestión
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              Te acompañamos en la administración digital y la comunicación
              constante para asegurar el crecimiento.
            </p>
          </article>
        </div>
      </div>

      <!-- Block 2: Enfoque, Cercanía, Autenticidad -->
      <div
        data-hover-zone="2"
        class="relative z-0 w-full bg-[var(--color-soft)] py-12 sm:py-20 lg:py-24"
      >
        <div class="mx-auto grid max-w-3xl gap-10 text-center">
          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Enfoque en resultados
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              Cada decisión de diseño tiene un objetivo de negocio: atraer,
              conectar y convertir.
            </p>
          </article>
          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Cercanía y colaboración
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              Trabajamos contigo, no para ti. Eres parte activa del proceso.
            </p>
          </article>
          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Autenticidad
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              No aplicamos fórmulas mágicas. Buscamos y potenciamos lo que hace
              única a tu empresa.
            </p>
          </article>
        </div>
      </div>

      <!-- The Sliding Banner: hidden on mobile, interactive on desktop -->
      <div
        data-process-banner
        class="pointer-events-none absolute left-0 top-0 z-10 hidden h-1/2 w-full items-center justify-center gap-4 bg-[var(--color-bg)] px-6 transition-transform duration-700 ease-in-out md:flex md:gap-8"
      >
        <img
          src="/assets/NEOLUM_ICONO_WHITE.svg"
          alt=""
          aria-hidden="true"
          class="h-[clamp(4rem,10vw,9rem)] w-auto shrink-0 opacity-80"
        />
        <h2
          class="text-balance text-center text-[clamp(4rem,10vw,9rem)] font-bold leading-[0.9] text-[var(--color-primary)]"
        >
          Proceso
        </h2>
        <img
          src="/assets/NEOLUM_ICONO_WHITE.svg"
          alt=""
          aria-hidden="true"
          class="h-[clamp(4rem,10vw,9rem)] w-auto shrink-0 opacity-80"
        />
      </div>
    </div>
  </SectionContainer>
</section>

<script is:inline>
  const container = document.querySelector("[data-process-container]");
  const banner = document.querySelector("[data-process-banner]");
  const zones = document.querySelectorAll("[data-hover-zone]");

  if (container && banner) {
    zones.forEach((zone) => {
      zone.addEventListener("mouseenter", () => {
        const id = zone.getAttribute("data-hover-zone");
        if (id === "1") {
          // Hover top block -> slide banner DOWN to show block 1
          banner.style.transform = "translateY(100%)";
        } else if (id === "2") {
          // Hover bottom block -> slide banner UP to show block 2
          banner.style.transform = "translateY(0%)";
        }
      });
    });

    // Reset to cover block 1 when leaving the entire section
    container.addEventListener("mouseleave", () => {
      banner.style.transform = "translateY(0%)";
    });
  }
</script>
