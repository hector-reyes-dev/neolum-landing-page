---
import SectionContainer from "../layout/SectionContainer.astro";
---

<section
  id="proceso"
  aria-label="Seccion de proceso"
  class="bg-[var(--color-bg)]"
>
  <SectionContainer isContent={true}>
    <div class="relative overflow-hidden" data-process-scene>
      <div
        data-process-first
        class="w-full bg-[var(--color-soft)] py-12 sm:py-16"
      >
        <div class="mx-auto grid max-w-3xl gap-10 text-center">
          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Fundación
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              Escuchamos, investigamos y definimos la estrategia y el rumbo de
              tu marca.
            </p>
          </article>

          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Desarrollo
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              Creamos tu identidad visual, diseñamos tu web y planificamos tu
              contenido.
            </p>
          </article>

          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Gestión
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              Te acompañamos en la administración digital y la comunicación
              constante para asegurar el crecimiento.
            </p>
          </article>
        </div>
      </div>

      <div
        class="h-[clamp(8rem,14vw,14rem)] bg-[var(--color-bg)]"
        aria-hidden="true"
      >
      </div>

      <div
        data-process-second
        class="w-full bg-[var(--color-soft)] py-12 sm:py-16"
      >
        <div class="mx-auto grid max-w-3xl gap-10 text-center">
          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Enfoque en resultados
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              Cada decisión de diseño tiene un objetivo de negocio: atraer,
              conectar y convertir.
            </p>
          </article>

          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Cercanía y colaboración
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              Trabajamos contigo, no para ti. Eres parte activa del proceso.
            </p>
          </article>

          <article>
            <h3
              class="text-balance text-[clamp(2rem,4vw,3rem)] font-bold leading-[0.95] text-[var(--color-primary)]"
            >
              Autenticidad
            </h3>
            <p
              class="text-pretty mx-auto mt-2 max-w-[30ch] text-[clamp(1.05rem,1.6vw,1.35rem)] leading-[1.25] text-black"
            >
              No aplicamos fórmulas mágicas. Buscamos y potenciamos lo que hace
              única a tu empresa.
            </p>
          </article>
        </div>
      </div>

      <div
        data-process-box
        class="pointer-events-none absolute left-0 top-0 z-10 hidden w-full will-change-transform"
      >
        <div
          data-process-box-surface
          class="flex items-center justify-center bg-[var(--color-bg)] py-16 sm:py-24 lg:py-28"
        >
          <h2
            class="text-balance text-center text-[clamp(4rem,10vw,9rem)] font-bold leading-[0.9] text-[var(--color-primary)]"
          >
            Proceso
          </h2>
        </div>
      </div>
    </div>
  </SectionContainer>
</section>

<script is:inline>
  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
  const scenes = document.querySelectorAll("[data-process-scene]");

  scenes.forEach((sceneNode) => {
    if (!(sceneNode instanceof HTMLElement)) return;

    const firstBlock = sceneNode.querySelector("[data-process-first]");
    const secondBlock = sceneNode.querySelector("[data-process-second]");
    const processBox = sceneNode.querySelector("[data-process-box]");
    const processBoxSurface = sceneNode.querySelector(
      "[data-process-box-surface]",
    );

    if (
      !(firstBlock instanceof HTMLElement) ||
      !(secondBlock instanceof HTMLElement) ||
      !(processBox instanceof HTMLElement) ||
      !(processBoxSurface instanceof HTMLElement)
    )
      return;

    let ticking = false;
    let phase1Start = 0,
      phase1End = 0;
    let phase2Start = 0,
      phase2End = 0;
    let yTop = 0,
      yMiddle = 0,
      yBottom = 0;

    // How many pixels of scroll each phase takes to complete
    const PHASE_DURATION = 500;
    // Offset thresholds (px from viewport edges)
    const TOP_OFFSET = 250; // banner top this far from viewport top  → phase 1 starts
    const BOTTOM_OFFSET = 50; // secondBlock bottom this far from viewport bottom → phase 2 starts

    const updateBoxPosition = () => {
      const scrollY = window.scrollY;
      let y;

      if (scrollY < phase1Start) {
        y = yTop;
      } else if (scrollY < phase1End) {
        const t = clamp((scrollY - phase1Start) / PHASE_DURATION, 0, 1);
        y = yTop + (yMiddle - yTop) * t;
      } else if (scrollY < phase2Start) {
        y = yMiddle;
      } else if (scrollY < phase2End) {
        const t = clamp((scrollY - phase2Start) / PHASE_DURATION, 0, 1);
        y = yMiddle + (yBottom - yMiddle) * t;
      } else {
        y = yBottom;
      }

      processBox.style.transform = `translate3d(0, ${y}px, 0)`;
      ticking = false;
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateBoxPosition);
    };

    const measureScene = () => {
      const vh = window.innerHeight;

      // Make banner same height as firstBlock so it covers it exactly
      processBoxSurface.style.minHeight = `${firstBlock.offsetHeight}px`;

      // Document-absolute positions
      const sceneDocTop =
        sceneNode.getBoundingClientRect().top + window.scrollY;
      const bannerDocTop = sceneDocTop + firstBlock.offsetTop; // banner starts over firstBlock
      const secondDocTop = sceneDocTop + secondBlock.offsetTop;
      const secondDocBottom = secondDocTop + secondBlock.offsetHeight;
      const bannerH = processBox.offsetHeight;

      // Banner Y positions (px relative to scene, used in translate)
      yTop = firstBlock.offsetTop; // covers firstBlock → initial state
      yMiddle = secondBlock.offsetTop; // covers secondBlock → after phase 1
      yBottom = yTop; // back up to firstBlock position → reveals secondBlock

      // Phase 1: starts when banner top is TOP_OFFSET px from viewport top
      // bannerDocTop - scrollY = TOP_OFFSET  →  scrollY = bannerDocTop - TOP_OFFSET
      phase1Start = bannerDocTop - TOP_OFFSET;
      phase1End = phase1Start + PHASE_DURATION;

      // Phase 2: starts when secondBlock bottom is BOTTOM_OFFSET px from viewport bottom
      // (secondDocBottom - scrollY) = vh - BOTTOM_OFFSET  →  scrollY = secondDocBottom - vh + BOTTOM_OFFSET
      phase2Start = secondDocBottom - vh + BOTTOM_OFFSET;
      phase2End = phase2Start + PHASE_DURATION;

      processBox.classList.remove("hidden");
      requestUpdate();
    };

    measureScene();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", measureScene);
    window.addEventListener("orientationchange", measureScene);
  });
</script>
