---
import SectionContainer from "../layout/SectionContainer.astro";

interface ProjectItem {
  name: string;
  backgroundSrc: string;
  backgroundAlt: string;
  logoSrc: string;
  logoAlt: string;
}

const projects: ProjectItem[] = [
  {
    name: "Nevia",
    backgroundSrc: "/assets/projects/proyectos-nevia-back-21x.webp",
    backgroundAlt: "Fotografia del proyecto Nevia",
    logoSrc: "/assets/projects/proyectos-nevia-front-2.svg",
    logoAlt: "Logo del proyecto Nevia",
  },
  {
    name: "Simple Meals",
    backgroundSrc: "/assets/projects/proyectos-simple-meals-back-11x.webp",
    backgroundAlt: "Fotografia del proyecto Simple Meals",
    logoSrc: "/assets/projects/proyectos-simple-meals-front-1.svg",
    logoAlt: "Logo del proyecto Simple Meals",
  },
  {
    name: "Latosa",
    backgroundSrc: "/assets/projects/proyectos-latosa-back-31x.webp",
    backgroundAlt: "Fotografia del proyecto Latosa",
    logoSrc: "/assets/projects/proyectos-latosa-front-3.svg",
    logoAlt: "Logo del proyecto Latosa",
  },
];
---

<SectionContainer
  id="proyectos"
  ariaLabel="Seccion de proyectos"
  isContent={true}
  flushMobile={true}
>
  <div class="grid md:grid-cols-2">
    <article
      class="flex aspect-square items-center justify-center bg-[var(--color-primary)] p-6 text-center sm:p-10"
    >
      <h3
        class="text-balance text-[clamp(4rem,10vw,8rem)] font-bold leading-[0.88] text-white"
      >
        Proyectos
      </h3>
    </article>

    {
      projects.map((project) => (
        <figure class="project-card group relative aspect-square overflow-hidden">
          <img
            src={project.backgroundSrc}
            alt={project.backgroundAlt}
            class="h-full w-full object-cover"
            loading="lazy"
          />

          <span class="project-blur-layer absolute inset-0" aria-hidden="true" />

          <figcaption class="pointer-events-none absolute inset-0">
            <img
              src={project.logoSrc}
              alt={project.logoAlt}
              class="h-full w-full object-contain"
              loading="lazy"
            />
          </figcaption>
        </figure>
      ))
    }
  </div>
</SectionContainer>

<style>
  .project-blur-layer {
    backdrop-filter: blur(0);
    transition: backdrop-filter 420ms ease-in-out;
  }

  @media (hover: hover) {
    .project-card .project-blur-layer {
      backdrop-filter: blur(10px);
    }

    .project-card:hover .project-blur-layer {
      backdrop-filter: blur(0);
    }
  }
</style>
